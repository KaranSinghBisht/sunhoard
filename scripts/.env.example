# Devnet only. These are optional: the scripts default to the values below.
# Do not put a private key in this file. The wallet is ANCHOR_WALLET, a path.
ANCHOR_PROVIDER_URL=https://api.devnet.solana.com
ANCHOR_WALLET=$HOME/.config/solana/sunhoard-admin.json
# MagicBlock's devnet private rollup. The scripts ask it for a token signed by the admin.
ER_URL=https://devnet-tee.magicblock.app
# Set to 1 before init-game.ts to open season 1 on the short demo clock.
SUNHOARD_DEMO=
