{
  "name": "sunhoard-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "vite --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "live": "esbuild scripts/live.ts --bundle --platform=node --format=cjs --log-level=error --define:import.meta.env={} --outfile=node_modules/.cache/live.cjs && node node_modules/.cache/live.cjs"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@magicblock-labs/ephemeral-rollups-sdk": "0.17.3",
    "@magicblock-labs/gum-sdk": "3.0.10",
    "@solana/wallet-adapter-base": "0.9.28",
    "@solana/wallet-adapter-react": "0.15.40",
    "@solana/wallet-adapter-react-ui": "0.9.35",
    "@solana/wallet-adapter-wallets": "0.19.32",
    "@solana/web3.js": "1.98.4",
    "buffer": "6.0.3",
    "phaser": "3.90.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tweetnacl": "1.0.3",
    "zustand": "5.0.8"
  },
  "resolutions": {
    "@coral-xyz/anchor": "0.32.1",
    "@solana/web3.js": "1.98.4",
    "@solana/wallet-adapter-react": "0.15.40",
    "@solana/wallet-adapter-base": "0.9.28"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "3.2.4"
  }
}
